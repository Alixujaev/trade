{
 "schema_version": "1.0",
 "task": "DAY-26C forward-data incident record",
 "title": "Unauthorised recent yfinance intraday download into data/cache during DAY-26B test verification",
 "recorded_utc": "2026-10-10T14:30:00Z",
 "recorded_by": "Claude (implementation agent), for the protocol owner Alixujaev",
 "severity": "protocol breach (DAY-22 §3.2.3; protocol 2.1 C3, C15, C16): forward-period market data acquired before permitted",
 "status": "CONTAINED — files quarantined; root cause fixed in tests/conftest.py; fwd-diag invalidated",
 "timeline_utc": [
  {
   "t": "2026-10-10T12:52:51Z",
   "event": "protocol 2.1 adoption recorded (artifacts/day26b/protocol-v2.1-adoption.json decided_utc); integrity_at_adoption was true at that time"
  },
  {
   "t": "2026-10-10T12:54:59Z..12:55:20Z",
   "event": "full suite run 1: pytest -q -p no:cacheprovider -x --ignore=smc-scanner; 318 passed, stopped at tests/test_day07_backtest.py (its function-scoped guard blocked the download: total_trades=0). Nothing written to data/cache (verified: data/cache absent afterwards)"
  },
  {
   "t": "2026-10-10T12:56:11Z (approx.)",
   "event": "full suite run 2 started: same command plus a session plugin refusing Python socket connections (-p nonet_plugin), intended as network-blocked"
  },
  {
   "t": "2026-10-10T12:56:23Z..12:59:51Z",
   "event": "54 files written to data/cache/ by YFinanceProvider through module-scoped fixtures of tests/test_day08*..test_day12b*: yf.download(period=60d, interval=5m|15m) for 27 symbols; requests made through curl_cffi (libcurl), which the socket plugin could not intercept (plugin reported 0 blocked attempts)"
  },
  {
   "t": "2026-10-10T12:56Z..13:37:02Z",
   "event": "the same run consumed the cached files: legacy day-trading backtests (DAY-08..DAY-12B experiments, index regime; not V2-MOM) ran on them inside pytest; 27 tests failed and pytest printed short failure summaries, some containing legacy trade-count values (e.g. 'test_json_serialization - assert 5783 ==...'). 1406 passed, 2 skipped"
  },
  {
   "t": "2026-10-10T13:4xZ",
   "event": "breach discovered (data/cache listing by name, size and time only), reported to the protocol owner, work stopped"
  },
  {
   "t": "2026-10-10T14:19:25.038251+00:00",
   "event": "DAY-26C containment: inventory (metadata + SHA-256, no parsing) and move of all 54 files to quarantine; post-move SHA-256 verified; files read-only; empty data/cache removed"
  }
 ],
 "correction_to_earlier_report": "the DAY-26B report said the files were written during the first full-suite run; the timestamps show they were written during the second (network-blocked) run. The first run wrote nothing.",
 "root_cause": {
  "summary": "tests/conftest.py guarded yf.download and real-cache writes only through function-scoped autouse fixtures; module-scoped fixtures (e.g. tests/test_day08_backtest.py:42 day08_run -> get_provider()) run before them, so the legacy provider downloaded and wrote the real cache unguarded",
  "contributing": [
   "the full pytest suite was run as a regression step although it contains legacy tests that depend on a market-data cache absent from this fresh clone",
   "a socket-level block was assumed to stop all network access; yfinance uses curl_cffi (libcurl)"
  ]
 },
 "exposure": {
  "files_inspected_by_agent": false,
  "market_values_parsed_or_viewed": false,
  "believed_coverage": "not inspected; yfinance period=60d intraday requested on 2026-10-10 is believed to span roughly the last 60 calendar days to 2026-10-09: Excluded-period sessions (<= 2026-10-07) and forward sessions 1-2 (2026-10-08, 2026-10-09)",
  "fwd_gate_sessions_exposed": "none possible: fwd-gate begins 2026-11-06, which did not exist at download time",
  "v2_mom_forward_metrics_computed": false,
  "consumption": "legacy day-trading strategy backtests (not V2-MOM) computed inside pytest; failure summaries with legacy trade counts were printed to the session output"
 },
