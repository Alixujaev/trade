# Alpaca Market Data API kredensiallari (FREE/paper tier, IEX feed yetarli).
# https://app.alpaca.markets/paper/dashboard/overview -> API Keys
# Nusxa ko'chiring: .env.example -> .env, va haqiqiy qiymatlarni kiriting.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Telegram bot (telegram_bot/) — @BotFather'dan token oling, o'z Telegram user_id'ingizni
# @userinfobot orqali toping. Faqat shu ID'ga bot javob beradi.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here
